# ══════════════════════════════════════════
#   LUMIERA — Environment Variables
# ══════════════════════════════════════════

# MongoDB Connection
# Local:
MONGODB_URI=mongodb://localhost:27017/lumiera
# Atlas (Cloud - replace with your URI):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lumiera

# JWT Secret Key (change this in production!)
JWT_SECRET=lumiera_secret_key_2026_change_me

# Server Port
PORT=3000

# Environment
NODE_ENV=development
